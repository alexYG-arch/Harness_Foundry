{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-foundry.local/schemas/resolved-command-manifest-1.0.json",
  "title": "Resolved Command Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "node_id", "environment_id", "commands"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "node_id": {"type": "string", "minLength": 1},
    "environment_id": {"type": "string", "minLength": 1},
    "commands": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "command_id",
          "stage",
          "executable_abs",
          "executable_sha256",
          "argv",
          "cwd_abs",
          "allowed_write_roots",
          "expected_exit_codes",
          "shell",
          "idempotent"
        ],
        "properties": {
          "command_id": {"type": "string", "minLength": 1},
          "stage": {
            "enum": ["execute", "postflight", "review", "fix", "cleanup"]
          },
          "executable_abs": {"type": "string", "minLength": 1},
          "executable_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "argv": {"type": "array", "minItems": 1},
          "cwd_abs": {"type": "string", "minLength": 1},
          "allowed_write_roots": {"type": "array"},
          "expected_exit_codes": {"type": "array", "minItems": 1},
          "shell": {"const": false},
          "idempotent": {"type": "boolean"},
          "independent_review": {"type": "boolean"},
          "failure_error_code": {"type": "string"},
          "side_effect_cleanup_confirmed": {"type": "boolean"},
          "timeout_seconds": {"type": "integer", "minimum": 1},
          "environment": {"type": "object"}
        }
      }
    }
  }
}
