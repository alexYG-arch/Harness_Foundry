{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-foundry.local/schemas/command-overlay-bundle-1.0.json",
  "title": "Resolved Command Manifest Overlay Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "overlay_kind",
    "program_id",
    "epoch_id",
    "candidate_content_sha256",
    "manifests"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "overlay_kind": {
      "const": "RESOLVED_COMMAND_OVERLAY_BUNDLE"
    },
    "program_id": {
      "type": "string",
      "minLength": 1
    },
    "epoch_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifests": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "schema_version",
          "node_id",
          "environment_id",
          "commands"
        ]
      }
    }
  }
}
