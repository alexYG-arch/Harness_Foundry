  "acceptance_cases": [
    {
      "case_id": "RC-AC-001",
      "expectation": "Changing exact implementation bytes while semantic contract and risk stay equal changes Implementation Release and Machine Grant identity but not Human Authorization Risk identity."
    },
    {
      "case_id": "RC-AC-002",
      "expectation": "Changing contract, scope, permission, network, secret, budget or irreversible effect produces Risk Delta and a human gate."
    },
    {
      "case_id": "RC-AC-003",
      "expectation": "Every Recovery mode passes positive, negative, crash and idempotent replay tests through one generic protocol."
    },
    {
      "case_id": "RC-AC-004",
      "expectation": "Adding a generic path without retiring at least one authoritative bespoke path is rejected."
    },
    {
      "case_id": "RC-AC-005",
      "expectation": "A second occurrence of the same control-fault fingerprint stops at ARCHITECTURE_REVIEW_REQUIRED."
    },
    {
      "case_id": "RC-AC-006",
      "expectation": "Product, Safety and Release can fail independently; one lane cannot overwrite another lane's closure status."
    },
    {
      "case_id": "RC-AC-007",
      "expectation": "Final Release fails unless all three current Closure Receipts and their compatibility/linkage decision pass."
    },
    {
      "case_id": "RC-AC-008",
      "expectation": "A clean future E2E uses one Architecture Freeze, one Parent for three node kinds, zero manual hashes, zero internal-flow human gates and at least one safe recovery."
    },
    {
      "case_id": "RC-AC-009",
      "expectation": "A derived Readback containing contradictory status facts in the same authority scope fails with PROJECTION_CONFLICT."
    },
    {
