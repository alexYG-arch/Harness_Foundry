{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:harness-foundry:requirement-ir:1.0",
  "type": "object",
  "required": [
    "program_id",
    "target",
    "sources",
    "atoms",
    "acceptance_cases",
    "negative_cases",
    "coverage_edges",
    "assumptions",
    "open_questions",
    "decisions",
    "user_adjustments"
  ],
  "properties": {
    "program_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "target": {
      "type": "object",
      "required": ["id", "name", "type", "profile", "output_root", "mission", "scope", "non_goals", "primary_runtime"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "name": {"type": "string", "minLength": 1},
        "type": {"enum": ["AGENT", "HARNESS", "HYBRID"]},
        "profile": {"enum": ["FULL", "STANDARD", "LITE"]},
        "output_root": {"type": "string", "minLength": 1},
        "mission": {"type": "string", "minLength": 1},
        "scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "non_goals": {"type": "array", "items": {"type": "string"}},
        "primary_runtime": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "sources": {"type": "array"},
    "atoms": {"type": "array", "minItems": 1},
    "acceptance_cases": {"type": "array", "minItems": 1},
    "negative_cases": {"type": "array", "minItems": 1},
    "assumptions": {"type": "array"},
    "open_questions": {"type": "array"},
    "decisions": {"type": "array"},
    "user_adjustments": {"type": "array"},
    "automation": {"type": "object"},
    "coverage_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["atom_id", "workpack_ids", "stage_ids", "release_step_ids", "owner_project_ids", "routing_basis"],
        "properties": {
          "atom_id": {"type": "string"},
          "workpack_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "stage_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "release_step_ids": {"type": "array", "items": {"type": "string"}},
          "owner_project_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "routing_basis": {"type": "string", "minLength": 1},
          "status": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "source_conflicts": {"type": "array"}
  },
  "additionalProperties": true
}
