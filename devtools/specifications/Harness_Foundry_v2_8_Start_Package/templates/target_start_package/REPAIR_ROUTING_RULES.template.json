    {"rule_id": "ROUTE-INSTALL-ORIGIN", "categories": ["INSTALL_ORIGIN"], "repair_owner": "MAIN_BUILD", "consulted_parties": ["CERTIFICATION_INSTALLER", "LINKAGE_TOOL", "EXTERNAL_LAB"], "earliest_reentry_gate": "P4_INSTALLABILITY"},
