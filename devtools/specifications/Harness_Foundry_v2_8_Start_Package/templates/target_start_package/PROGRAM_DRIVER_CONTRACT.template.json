{
  "schema_version": "2.8",
  "contract_id": "<PROGRAM-DRIVER-CONTRACT-ID>",
  "program_id": "<PROGRAM-ID>",
  "driver_role": "BUILD_PROGRAM_DRIVER",
  "driver_entrypoint_abs": "<ABSOLUTE-DRIVER-ENTRYPOINT>",
  "driver_started_by_authoring": false,
  "runtime_verification_required_before_side_effects": true,
  "runtime_verification_ref": "<PROGRAM-DRIVER-RUNTIME-ATTESTATION-REF>",
  "pre_verification_allowed_commands": ["status", "plan-next", "validate-transition"],
  "authoring_stop_state": "START_PACKAGE_CANDIDATE_READY_FOR_HUMAN_REVIEW",
  "required_inputs": [
    "START_CONTEXT.json",
    "THREE_PROJECT_PROGRAM_MANIFEST.json",
    "ENGINEERING_PROJECT_DAG.json",
    "PROGRAM_STATE.json",
    "PHASE_DEPENDENCY_MANIFEST.json",
    "WORKPACK_INDEX.json",
    "RELEASE_PIPELINE_MANIFEST.json",
    "PROGRAM_AUTOMATION_POLICY.json",
    "AUTHORIZATION_POLICY.json",
    "PROGRAM_DRIVER_STATE.json"
  ],
  "commands": [
    {"name": "status", "mutates": false, "requires_authorization": false, "output": "PROGRAM_STATUS_READBACK"},
    {"name": "plan-next", "mutates": false, "requires_authorization": false, "output": "NEXT_ELIGIBLE_TRANSITION_PLAN"},
    {"name": "validate-transition", "mutates": false, "requires_authorization": false, "output": "TRANSITION_VALIDATION_RESULT"},
    {"name": "advance", "mutates": true, "requires_authorization": true, "output": "ONE_TRANSITION_RESULT"},
    {"name": "advance-until-gate", "mutates": true, "requires_authorization": true, "output": "BOUNDED_ADVANCE_RESULT"},
    {"name": "run-loop", "mutates": true, "requires_authorization": true, "output": "LOOP_STATE_UPDATE"},
    {"name": "record-finding", "mutates": true, "requires_authorization": true, "output": "FINDING_RECORD"},
    {"name": "invalidate", "mutates": true, "requires_authorization": true, "output": "REVOCATION_EVENT"},
    {"name": "plan-reentry", "mutates": false, "requires_authorization": false, "output": "REENTRY_PLAN"},
    {"name": "resume", "mutates": true, "requires_authorization": true, "output": "RESUME_RESULT"}
  ],
  "decision_algorithm": [
    "LOAD_AND_HASH_ALL_REQUIRED_INPUTS",
    "REJECT_SCHEMA_VERSION_OR_HASH_DRIFT",
    "CONFIRM_NO_OPEN_BLOCKER_OR_UNPROPAGATED_INVALIDATION",
    "COMPUTE_EXACTLY_ONE_NEXT_ELIGIBLE_NODE",
    "VALIDATE_PREDECESSOR_LOCKS_AND_GATE_REPORTS",
    "VALIDATE_UNREVOKED_AUTHORIZATION_SCOPE_AND_EXPIRY",
    "VALIDATE_COMMAND_HASH_AND_ABSOLUTE_EXECUTABLE",
    "EXECUTE_AT_MOST_AUTHORIZED_TRANSITION_BUDGET",
    "CAPTURE_STDOUT_STDERR_EXIT_CODE_AND_RUNTIME_ATTESTATION",
    "WRITE_RESULT_THEN_VALIDATE_RESULT",
    "APPEND_PROMOTION_OR_REVOCATION_EVENT",
    "STOP_AT_HUMAN_GATE_BLOCKER_FAILURE_OR_BUDGET"
  ],
  "safety_invariants": {
    "single_active_workpack": true,
    "single_active_dag_node": true,
    "shell_command_strings_forbidden": true,
    "absolute_executable_required": true,
    "command_hash_allowlist_required": true,
    "pass_result_alone_cannot_promote": true,
    "promotion_event_required": true,
    "loop_converged_is_not_pass": true,
    "no_phase_skip": true,
    "no_implicit_not_applicable": true,
    "real_target_install_never_covered_by_generic_authorization": true
  },
  "hard_stop_states": [
    "WAITING_HUMAN_GATE",
    "AUTHORIZATION_MISSING_OR_INVALID",
    "BLOCKED",
    "FAIL",
    "AMBIGUOUS_NEXT_TRANSITION",
    "HASH_OR_SCHEMA_DRIFT",
    "OPEN_INVALIDATION",
    "LOOP_ESCALATED",
    "REAL_TARGET_INSTALL_AUTHORIZATION_REQUIRED"
  ],
  "state_ref": "PROGRAM_DRIVER_STATE.json",
  "transition_ledger_ref": "PHASE_TRANSITION_LEDGER.jsonl",
  "promotion_ledger_ref": "PROMOTION_LEDGER.jsonl",
  "revocation_ledger_ref": "REVOCATION_LEDGER.jsonl"
}
