{
  "workspace_root": "/REPLACE/resource-example/product",
  "source_read_roots": ["/REPLACE/python-runtime-read-root"],
  "verification_root": "/REPLACE/foundry/examples/resource-check/verifier",
  "task_write_roots": {"MAKE-SUMMARY": ["outputs"]},
  "executables": {"python": "/REPLACE/project/.venv/bin/python"},
  "codex_executable": "/REPLACE/native-codex-receiver",
  "model": null,
  "allow_model_service": false,
  "max_attempts": 3,
  "max_task_attempts": 3,
  "command_timeout_seconds": 30,
  "expires_at": "REPLACE_WITH_REVIEWED_FUTURE_ISO_TIME_WITH_TIMEZONE",
  "verification_resources": {
    "schema_version": "1.0",
    "root": "/REPLACE/resource-example/resources",
    "checker_files": ["expected.json"],
    "profiles": {
      "offline": {
        "writable_areas": ["scratch", "report-staging"],
        "network": {"mode": "NONE"},
        "services": [],
        "result_protocol": "STRUCTURED_V1",
        "report_files": ["summary.json"],
        "required_checks": ["product", "temp", "sqlite"],
        "retention": {"success": "REPORTS_ONLY", "failure_days": 7},
        "product_copy": {
          "files": ["tools/summarize.py", "fixtures/rows.json", "outputs/summary.json"],
          "writable_paths": [".cache", "build"]
        }
      }
    }
  }
}
