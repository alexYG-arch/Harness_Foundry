{
  "name": "local-dashboard",
  "version": "5",
  "usage": "both",
  "inputs": [
    "Explicit selected run identities and read-only sanitized display projections supplied by the host adapter",
    "Optional external theme preference: system, light or dark; omitted preserves system behavior",
    "Optional cumulative work progress and named workflow steps with sanitized history; current valid acceptance remains separate"
  ],
  "outputs": [
    "A loopback-only observer URL plus embedded/browser view URLs, cached snapshots, SSE and shared page/PiP presentation"
  ],
  "materials": [
    "guide.md",
    "target-guide.md",
    "target/INSTRUCTIONS.md"
  ],
  "tools": [
    {
      "id": "local-dashboard",
      "path": "dashboard.py",
      "interpreter": "python",
      "interpreter_args": [
        "-I",
        "-B"
      ]
    },
    {
      "id": "target-dashboard",
      "path": "target.py",
      "interpreter": "python",
      "interpreter_args": [
        "-I",
        "-B"
      ]
    }
  ],
  "runtime_files": [
    "capability.json",
    "web/index.html",
    "web/app.js",
    "web/style.css"
  ],
  "environment": [
    {
      "id": "python",
      "kind": "executable",
      "version_min": "3.11"
    }
  ],
  "support": "Optional host-owned observer with explicit Foundry or target-native adapters. No business dispatch, acceptance, budget or recovery authority. Real task, device and browser acceptance remain separately scoped.",
  "descriptor_version": 2,
  "features": [
    {
      "id": "target-observer",
      "summary": "target observer",
      "kind": "tool",
      "files": [
        "target.py",
        "dashboard.py",
        "web/index.html",
        "web/app.js",
        "web/style.css",
        "capability.json"
      ],
      "default_form": "AS_IS",
      "requires": [],
      "conflict_tags": [
        "PERSISTENT_PROCESS",
        "REQUIRES_HOST_TOOL"
      ],
      "checks": [
        "Check the declared result with independent project inputs and expectations."
      ],
      "entry": {
        "tool": "target-dashboard"
      }
    },
    {
      "id": "foundry-observer",
      "summary": "foundry observer",
      "kind": "tool",
      "files": [
        "dashboard.py",
        "web/index.html",
        "web/app.js",
        "web/style.css",
        "capability.json"
      ],
      "default_form": "BUILD_ONLY",
      "requires": [],
      "conflict_tags": [
        "PERSISTENT_PROCESS",
        "REQUIRES_HOST_TOOL"
      ],
      "checks": [
        "Check the declared result with independent project inputs and expectations."
      ],
      "entry": {
        "tool": "local-dashboard"
      },
      "usage": "build"
    },
    {
      "id": "display-modes",
      "summary": "display modes",
      "kind": "workflow",
      "files": [
        "web/app.js",
        "web/style.css"
      ],
      "default_form": "AS_IS",
      "requires": [
        "target-observer"
      ],
      "conflict_tags": [
        "INTERACTIVE_ONLY",
        "REQUIRES_HOST_TOOL"
      ],
      "checks": [
        "Check the declared result with independent project inputs and expectations."
      ]
    }
  ],
  "delivery": {
    "instruction_snippet": "target/INSTRUCTIONS.md"
  }
}
