{
  "name": "qt-cmake",
  "version": "3",
  "usage": "both",
  "inputs": [
    "Explicit Qt SDK, CMake/CTest and Qt helper Python invocation bindings; a generated nonsecret environment profile",
    "Project-owned source, isolated build/report paths and independent required-test assertions"
  ],
  "outputs": [
    "Versioned public environment and delivery files; observed selected tool/QtCore dependency evidence",
    "One retained record for each explicit configure/build/test or declared smoke-probe command"
  ],
  "materials": [
    "guide.md",
    "target/INSTRUCTIONS.md"
  ],
  "tools": [
    {
      "id": "qt-cmake",
      "path": "qt_cmake.py",
      "interpreter": "qt-python",
      "interpreter_args": [
        "-I",
        "-B"
      ]
    },
    {
      "id": "qt-environment",
      "path": "qt_environment.py",
      "interpreter": "qt-python",
      "interpreter_args": [
        "-I",
        "-B"
      ]
    }
  ],
  "runtime_files": [
    "stack_runtime.py",
    "probe-CMakeLists.txt",
    "probe-main.cpp",
    "native_dependencies.py",
    "environment.py"
  ],
  "verification_files": [
    "check_ctest.py",
    {
      "path": "qt_environment.py",
      "shared": true
    },
    {
      "path": "stack_runtime.py",
      "shared": true
    },
    {
      "path": "native_dependencies.py",
      "shared": true
    }
  ],
  "environment": [
    {
      "id": "qt-python",
      "kind": "executable",
      "version_min": "3.11"
    },
    {
      "id": "cmake",
      "kind": "executable",
      "version_min": "3.21"
    },
    {
      "id": "ctest",
      "kind": "executable",
      "version_min": "3.21"
    },
    {
      "id": "qt-sdk",
      "kind": "directory"
    }
  ],
  "support": "Native QtCore/CMake environment bridge. SDK dependencies and permissions remain declared by the host. First native validation is macOS; other layouts require their selected observation/probe. No installation, scheduler, retries, global preflight, network expansion or acceptance authority.",
  "descriptor_version": 2,
  "features": [
    {
      "id": "stack-profile",
      "summary": "stack profile",
      "kind": "tool",
      "files": [
        "qt_environment.py",
        "stack_runtime.py",
        "native_dependencies.py",
        "environment.py"
      ],
      "default_form": "BRIDGED",
      "requires": [],
      "conflict_tags": [
        "EXTERNAL_BINARY",
        "PLATFORM_SPECIFIC"
      ],
      "checks": [
        "Check the declared result with independent project inputs and expectations."
      ],
      "entry": {
        "tool": "qt-environment"
      }
    },
    {
      "id": "environment-probe",
      "summary": "environment probe",
      "kind": "tool",
      "files": [
        "probe-CMakeLists.txt",
        "probe-main.cpp"
      ],
      "default_form": "BRIDGED",
      "requires": [
        "stack-profile"
      ],
      "conflict_tags": [
        "EXTERNAL_BINARY"
      ],
      "checks": [
        "Check the declared result with independent project inputs and expectations."
      ],
      "entry": {
        "tool": "qt-environment"
      }
    },
    {
      "id": "project-commands",
      "summary": "project commands",
      "kind": "tool",
      "files": [
        "qt_cmake.py"
      ],
      "default_form": "BRIDGED",
      "requires": [
        "stack-profile"
      ],
      "conflict_tags": [
        "EXTERNAL_BINARY"
      ],
      "checks": [
        "Check the declared result with independent project inputs and expectations."
      ],
      "entry": {
        "tool": "qt-cmake"
      }
    }
  ],
  "delivery": {
    "instruction_snippet": "target/INSTRUCTIONS.md",
    "doctor": {
      "tool": "qt-environment",
      "args": [
        "doctor"
      ]
    }
  }
}
